PORT=3598

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=admin
DB_PASSWORD="your-db-password"
DB_NAME=rdm

DOWNLOAD_BASE_PATH=/mnt/4tb-1/RDM/downloads
DOWNLOAD_FINAL_PATH=/mnt/4tb/ENTERTAINMENT/RDM DOWNLOADS
STAGING_CLEANUP_ENABLED=true
STAGING_CLEANUP_INTERVAL_HOURS=24
STAGING_CLEANUP_CHECK_MS=3600000

# GitHub auto-update (Updates tab + background checks)
GITHUB_REPO=TechVatika/RDM---Remote-Download-Manager
AUTO_UPDATE_CHECK_ENABLED=true
AUTO_UPDATE_CHECK_MS=300000
AUTO_UPDATE_APPLY=false

MAX_CONCURRENT_DOWNLOADS=4
WORKER_POLL_MS=500

# HTTP downloads — parallel range segments per file (lower = gentler on your network)
DOWNLOAD_CONNECTIONS=4
DOWNLOAD_MAX_CONNECTIONS=16
DOWNLOAD_INSPECT_TIMEOUT_MS=12000
DOWNLOAD_MIN_SEGMENT_BYTES=524288
# Per-chunk retries when a CDN drops a connection mid-download (large files need more)
DOWNLOAD_SEGMENT_RETRIES=8

# yt-dlp parallel fragments for YouTube / HLS / DASH (lower = gentler WAN usage)
YTDLP_CONCURRENT_FRAGMENTS=2
YTDLP_PARALLEL=2

# Public-only mode: blocks IG/FB session tokens & stored passwords.
# Browser cookies and cookies.txt still work (needed for 18+ age-gated sites).
PUBLIC_MEDIA_ONLY=true

# Media downloads (yt-dlp)
YTDLP_BIN=yt-dlp
# Optional: path to Netscape cookies.txt (age-gated / login sites)
# YTDLP_COOKIES_FILE=/path/to/cookies.txt

# Adult sites ONLY — Cloudflare WARP proxy mode (recommended)
# Install: sudo bash scripts/install-cloudflare-warp.sh
ADULT_SITES_USE_WARP=true
# WARP_PROXY_PORT=40000

# Or use a custom SOCKS/HTTP proxy instead of WARP:
# ADULT_SITES_PROXY=socks5h://127.0.0.1:1080

# Authentication (default user created on first startup if none exists)
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# AI smart file naming — Google Gemini (recommended) or OpenAI
AI_RENAME=true
AI_PROVIDER=gemini
# auto | gemini | openai — auto picks Gemini when GEMINI_API_KEY is set

# Google Gemini — get key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI-compatible fallback (OpenAI, OpenRouter, Ollama)
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
